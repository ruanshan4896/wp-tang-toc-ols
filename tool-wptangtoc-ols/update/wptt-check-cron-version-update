#!/bin/bash
# @author: Gia Tuấn
# @website: https://wptangtoc.com
# @email: giatuan@wptangtoc.com

umask 077

# Tạo thư mục tạm thời để xử lý an toàn
TMP_DIR=$(mktemp -d /etc/wptt/tmp/XXXXXX)
cd "$TMP_DIR" || exit

# ==============================================================================
# BỘ MÁY XÁC THỰC BẢO MẬT GPG & FINGERPRINT PINNING (CHẠY NGẦM)
# ==============================================================================
# ==============================================================================
# 2. TẢI FILE PHIÊN BẢN TỪ FORK
# ==============================================================================
curl --tlsv1.2 -sL --connect-timeout 60 --max-time 60 "https://raw.githubusercontent.com/ruanshan4896/wp-tang-toc-ols/main/version-wptangtoc-ols.txt" -o version.txt

if [[ ! -s version.txt ]]; then
	curl --tlsv1.3 -sL --connect-timeout 60 --max-time 60 "https://wptangtoc.com/share/version-wptangtoc-ols.txt?kiem-tra-version-crond" -o version.txt
fi

if [[ -s version.txt ]]; then
	# Lấy dòng đầu tiên và lọc đúng định dạng phiên bản (có dấu chấm)
	wptangtocols_version=$(head -1 version.txt | grep '\.')

	if [[ -n "$wptangtocols_version" ]]; then
		echo "$wptangtocols_version" > "/etc/wptt/tmp/new-version"
		mv "/etc/wptt/tmp/new-version" /etc/wptt/tmp/wptangtoc-ols-version
	fi
fi

# 4. Dọn dẹp chiến trường không để lại rác
cd /root || exit
if [[ -n "$TMP_DIR" ]];then
	rm -rf "${TMP_DIR:?}"
fi
